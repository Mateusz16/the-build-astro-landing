---
import "../styles/global.css";

const services = [
  ["01", "Remonty kompleksowe", "Prowadzimy cały zakres prac — od demontażu i instalacji po ostatnią warstwę farby."],
  ["02", "Wykończenia wnętrz", "Realizujemy mieszkania i domy w standardzie dopasowanym do projektu, budżetu i codziennego życia."],
  ["03", "Łazienki i kuchnie", "Koordynujemy instalacje, zabudowy, glazurę i montaż wyposażenia w jednym harmonogramie."],
  ["04", "Instalacje", "Wykonujemy modernizacje elektryczne, hydrauliczne i wentylacyjne zgodnie z projektem."],
  ["05", "Prace budowlane", "Ściany, sufity, tynki, posadzki i przebudowy funkcjonalne wykonywane przez jeden zespół."],
  ["06", "Modernizacje lokali", "Przekształcamy biura, lokale usługowe i przestrzenie inwestycyjne bez zbędnych przestojów."],
];

const projects = [
  ["Kompleksowe wykończenie", "Apartament Powiśle", "Warszawa / 92 m² / 2025", "/project-apartment.jpg"],
  ["Remont domu", "Dom pod Warszawą", "Konstancin / 180 m² / 2025", "/project-house.jpg"],
  ["Kuchnia i strefa dzienna", "Loft na Woli", "Warszawa / 68 m² / 2024", "/project-loft.jpg"],
];

const process = [
  ["01", "Rozmowa", "Poznajemy zakres, oczekiwania, lokalizację i planowany termin."],
  ["02", "Wizja lokalna", "Sprawdzamy warunki techniczne i doprecyzowujemy rozwiązania."],
  ["03", "Wycena i plan", "Otrzymujesz czytelny zakres, koszt oraz harmonogram prac."],
  ["04", "Realizacja", "Prowadzimy prace, raportujemy postęp i przekazujemy gotową przestrzeń."],
];

const faqs = [
  ["Ile trwa przygotowanie wyceny?", "Wstępny zakres omawiamy podczas pierwszej rozmowy. Szczegółową wycenę przygotowujemy zwykle w ciągu 3–5 dni roboczych od wizji lokalnej."],
  ["Czy pomagacie w wyborze i zakupie materiałów?", "Tak. Możemy przygotować zestawienie materiałów, zamówić je i skoordynować dostawy albo pracować na produktach kupionych przez inwestora."],
  ["Czy można zlecić tylko część prac?", "Tak. Realizujemy zarówno kompleksowe wykończenia, jak i precyzyjnie określone etapy — na przykład łazienkę, instalacje albo prace malarskie."],
  ["Gdzie realizujecie zlecenia?", "Działamy na terenie Warszawy i w promieniu około 40 km. Większe realizacje poza tym obszarem rozpatrujemy indywidualnie."],
];

const title = "The Build — remonty i wykończenia w Warszawie";
const description = "Kompleksowe remonty i wykończenia wnętrz. Jasna wycena, jeden opiekun i sprawdzony proces od pomiaru do odbioru.";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL("/og-blueprint.png", Astro.site);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a1b2b" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Build — budujemy, remontujemy, dowozimy efekt" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Przejdź do treści</a>
    <header class="site-header">
      <a class="brand" href="#start" aria-label="The Build — strona główna">
        <span class="brand-mark" aria-hidden="true">TB</span><span>THE BUILD</span>
      </a>
      <button class="menu-button" type="button" aria-label="Otwórz menu" aria-expanded="false" aria-controls="site-navigation"><span></span><span></span></button>
      <nav id="site-navigation" class="site-nav" aria-label="Główna nawigacja">
        <a href="#uslugi">Usługi</a><a href="#realizacje">Realizacje</a><a href="#proces">Jak działamy</a><a href="#kontakt">Kontakt</a>
      </nav>
      <a class="button button-small header-cta" href="#kontakt">Poproś o wycenę <span aria-hidden="true">↗</span></a>
    </header>

    <main id="main-content">
      <section class="hero" id="start">
        <div class="hero-copy">
          <p class="eyebrow"><span></span> Remonty i wykończenia / Warszawa</p>
          <h1>Budujemy. Remontujemy. <em>Dowozimy efekt.</em></h1>
          <p class="hero-lead">Jeden zespół, konkretny plan i pełna odpowiedzialność za realizację — od pierwszego pomiaru po gotowe wnętrze.</p>
          <div class="hero-actions">
            <a class="button" href="#kontakt">Poproś o bezpłatną wycenę <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#realizacje">Zobacz realizacje <span aria-hidden="true">↓</span></a>
          </div>
        </div>
        <div class="hero-visual">
          <img src="/hero-construction.jpg" alt="Ekipa budowlana podczas realizacji nowoczesnego budynku" width="1800" height="1200" fetchpriority="high" />
          <div class="hero-label"><span>Aktualna realizacja</span><strong>Dom / Wilanów</strong></div>
          <span class="measure measure-x" aria-hidden="true">12,40 M</span><span class="measure measure-y" aria-hidden="true">+ 03,20</span>
        </div>
      </section>

      <section class="stats" aria-label="The Build w liczbach">
        <div><strong>12+</strong><span>lat doświadczenia</span></div><div><strong>240+</strong><span>ukończonych realizacji</span></div><div><strong>4,9/5</strong><span>średnia ocen klientów</span></div><div><strong>96%</strong><span>prac oddanych w terminie</span></div>
      </section>

      <section class="section services" id="uslugi">
        <div class="section-heading">
          <p class="eyebrow dark"><span></span> Zakres prac</p>
          <h2>Od pustych ścian<br />do gotowej przestrzeni.</h2>
          <p>Kompleksowo lub etapami. Zawsze z jasnym zakresem odpowiedzialności.</p>
        </div>
        <div class="service-grid">
          {services.map(([number, serviceTitle, text]) => (
            <article class="service-card">
              <span>{number}</span><h3>{serviceTitle}</h3><p>{text}</p>
              <a href="#kontakt" aria-label={`Zapytaj o: ${serviceTitle}`}>Zapytaj o usługę <b aria-hidden="true">↗</b></a>
            </article>
          ))}
        </div>
      </section>

      <section class="section proof">
        <div class="proof-image"><img src="/team-plans.jpg" alt="Specjaliści analizujący plany budowlane na miejscu realizacji" width="1500" height="1000" loading="lazy" /><span>Koordynacja / Nadzór / Odbiór</span></div>
        <div class="proof-copy">
          <p class="eyebrow"><span></span> Dlaczego The Build</p><h2>Mniej chaosu.<br />Więcej kontroli.</h2>
          <p class="proof-lead">Remont nie musi oznaczać ciągłych telefonów, niedomówień i niespodziewanych kosztów.</p>
          <ul>
            <li><span>01</span><div><strong>Przejrzysta wycena</strong><p>Wiesz, za co płacisz, zanim zaczniemy prace.</p></div></li>
            <li><span>02</span><div><strong>Jeden opiekun projektu</strong><p>Masz jeden kontakt i regularną informację o postępie.</p></div></li>
            <li><span>03</span><div><strong>Uporządkowany proces</strong><p>Zakupy, dostawy i ekipy pracują według wspólnego planu.</p></div></li>
          </ul>
        </div>
      </section>

      <section class="section projects" id="realizacje">
        <div class="section-heading projects-heading">
          <div><p class="eyebrow dark"><span></span> Wybrane realizacje</p><h2>Efekt mówi najwięcej.</h2></div>
          <p>Wnętrza i przestrzenie przygotowane do codziennego użytkowania — technicznie dopracowane, wizualnie spójne.</p>
        </div>
        <div class="project-list">
          {projects.map(([type, projectTitle, place, image], index) => (
            <article class="project-card">
              <div class="project-image"><img src={image} alt={`${projectTitle} — ${type}`} width="1600" height="1100" loading="lazy" /><span>0{index + 1}</span></div>
              <div class="project-meta"><p>{type}</p><h3>{projectTitle}</h3><span>{place}</span></div>
            </article>
          ))}
        </div>
      </section>

      <section class="section process" id="proces">
        <div class="process-intro"><p class="eyebrow"><span></span> Jak działamy</p><h2>Cztery kroki.<br />Jeden cel.</h2><p>Od początku wiesz, co wydarzy się dalej i kto odpowiada za każdy etap.</p><a class="button" href="#kontakt">Zacznijmy od rozmowy <span aria-hidden="true">↗</span></a></div>
        <ol class="process-list">{process.map(([number, processTitle, text]) => <li><span>{number}</span><div><h3>{processTitle}</h3><p>{text}</p></div></li>)}</ol>
      </section>

      <section class="section testimonial">
        <p class="quote-mark" aria-hidden="true">“</p>
        <blockquote>Wszystko było jasno ustalone jeszcze przed startem. W trakcie remontu dostawaliśmy regularne informacje, a mieszkanie odebraliśmy dokładnie w umówionym terminie.</blockquote>
        <div class="quote-author"><span>MK</span><p><strong>Monika i Krzysztof</strong><br />remont mieszkania / Mokotów</p></div>
      </section>

      <section class="section faq">
        <div class="section-heading faq-heading"><p class="eyebrow dark"><span></span> Najczęstsze pytania</p><h2>Konkrety przed startem.</h2></div>
        <div class="faq-list">{faqs.map(([question, answer], index) => <details open={index === 0}><summary><span>0{index + 1}</span>{question}<b aria-hidden="true">+</b></summary><p>{answer}</p></details>)}</div>
      </section>

      <section class="section contact" id="kontakt">
        <div class="contact-copy">
          <p class="eyebrow"><span></span> Porozmawiajmy o realizacji</p><h2>Masz plan?<br /><em>Zbudujmy go.</em></h2><p>Opowiedz krótko, czego potrzebujesz. Wrócimy z pytaniami i propozycją następnego kroku.</p>
          <div class="contact-details"><div><span>Telefon</span><a href="tel:+48221852040">+48 22 185 20 40</a></div><div><span>E-mail</span><a href="mailto:kontakt@thebuild.pl">kontakt@thebuild.pl</a></div><div><span>Obszar</span><strong>Warszawa + 40 km</strong></div></div>
        </div>
        <form class="contact-form" data-demo-form>
          <div class="field-row"><label>Imię i nazwisko<input required name="name" autocomplete="name" placeholder="Jan Kowalski" /></label><label>Telefon lub e-mail<input required name="contact" placeholder="Jak się z Tobą skontaktować?" /></label></div>
          <div class="field-row"><label>Rodzaj prac<select required name="service"><option value="" selected disabled>Wybierz zakres</option><option>Remont kompleksowy</option><option>Wykończenie wnętrza</option><option>Łazienka lub kuchnia</option><option>Instalacje</option><option>Inny zakres</option></select></label><label>Lokalizacja<input required name="location" placeholder="Miasto / dzielnica" /></label></div>
          <label>Opowiedz o realizacji<textarea required name="message" rows="4" placeholder="Metraż, planowany termin, zakres prac…"></textarea></label>
          <label class="consent"><input required type="checkbox" /><span>Zgadzam się na kontakt w sprawie wyceny i akceptuję politykę prywatności.</span></label>
          <button class="button form-button" type="submit">Wyślij zapytanie <span aria-hidden="true">↗</span></button>
          <p class="form-success" role="status" hidden>Dziękujemy. To demonstracyjny formularz — wiadomość nie została wysłana.</p>
        </form>
      </section>
    </main>

    <footer>
      <a class="brand footer-brand" href="#start"><span class="brand-mark" aria-hidden="true">TB</span><span>THE BUILD</span></a>
      <p>Remonty i wykończenia, które trzymają poziom.</p>
      <nav aria-label="Nawigacja w stopce"><a href="#uslugi">Usługi</a><a href="#realizacje">Realizacje</a><a href="#proces">Proces</a><a href="#kontakt">Kontakt</a></nav>
      <div class="footer-bottom"><span>© 2026 The Build</span><span>Strona demonstracyjna</span><a href="#start">Do góry ↑</a></div>
    </footer>

    <script>
      const menuButton = document.querySelector<HTMLButtonElement>(".menu-button");
      const navigation = document.querySelector<HTMLElement>(".site-nav");
      menuButton?.addEventListener("click", () => {
        const open = navigation?.classList.toggle("is-open") ?? false;
        menuButton.setAttribute("aria-expanded", String(open));
        menuButton.setAttribute("aria-label", open ? "Zamknij menu" : "Otwórz menu");
      });
      navigation?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
        navigation.classList.remove("is-open");
        menuButton?.setAttribute("aria-expanded", "false");
      }));
      const form = document.querySelector<HTMLFormElement>("[data-demo-form]");
      const success = form?.querySelector<HTMLElement>(".form-success");
      form?.addEventListener("submit", (event) => {
        event.preventDefault();
        if (!form.checkValidity()) return form.reportValidity();
        if (success) success.hidden = false;
      });
    </script>
  </body>
</html>
